      m_Calls: []
  m_text: "Movement & Camera\r\n  - Move: W/A/S/D\r\n  - Look Around: Move Mouse\r\n\r\nCharacter
    Actions\r\n  - Sprint: Left Shift\r\n  - Jump: Space\r\n  - Crouch: C\r\n\r\nCombat
    Controls\r\n  - Attack (Shoot/Throw): Left Click Mouse\r\n  - Aim (Combat State):
    Right Click Mouse\r\n  - Reload: R\r\n  - Drop Weapon: G\r\n\r\nCamera & View\r\n 
    - SwitchShoulder: V\r\n  - Zoom: Scroll Wheel\r\n\r\nInventory & Items\r\n  -
    Switch Item: 1/2/3/4\r\n  - Select Item (Shop In Game): 1 -> 9\r\n  - Buy Item:
    Enter\r\n\r\nIn-Game Menu\r\n  - Open Shop In Game: B\r\n  - Open Result Table
    / Scoreboard: Tab\r\n  - Pause Game: Escape\r\n\r\nNOTES:\r\n  - Controls support
    Keyboard + Mouse\r\n  - Some action use:\r\n    . Press: single action (example:
    Jump)\r\n    . Hold: continuous action (example: Shooting, Sprinting)"
  m_isRightToLeft: 0
